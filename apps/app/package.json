{
  "name": "@zapengine/app",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "entrypoint.js",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "scripts": {
    "dev": "expo start --dev-client --port 8081",
    "dev:web": "expo start --web --port 8081",
    "postinstall": "node scripts/install-playwright.mjs",
    "eas-build-post-install": "cd ../.. && pnpm turbo run build --filter=@zapengine/app-core",
    "start": "expo start --dev-client --port 8081",
    "android": "pnpm run android:native",
    "android:native": "expo run:android --no-bundler",
    "android:eas:login": "node scripts/eas.mjs login",
    "android:eas:init": "node scripts/eas.mjs init",
    "android:credentials": "node scripts/eas.mjs credentials --platform android",
    "android:version:init": "node scripts/eas.mjs build:version:set --platform android",
    "android:release": "node scripts/build-production.mjs android",
    "android:release:local": "mkdir -p dist/android && node scripts/eas.mjs build --platform android --profile production --local --output dist/android/zap-pilot-release.aab",
    "android:submit": "node scripts/submit-production-build.mjs android",
    "android:publish": "node scripts/eas.mjs build --platform android --profile production --auto-submit-with-profile production",
    "ios": "pnpm run ios:native",
    "ios:native": "pnpm run ios:native:sync && expo run:ios --no-bundler",
    "ios:native:sync": "node scripts/sync-ios-native.mjs",
    "ios:archive": "node scripts/ios-archive.mjs",
    "ios:credentials": "node scripts/eas.mjs credentials --platform ios",
    "ios:version:init": "node scripts/eas.mjs build:version:set --platform ios",
    "ios:version:check": "node scripts/assert-ios-remote-version.mjs",
    "ios:release": "node scripts/build-production.mjs ios",
    "ios:submit": "node scripts/submit-production-build.mjs ios",
    "ios:bundle-check": "node scripts/assert-ios-bundle-clean.cjs",
    "build": "EXPO_NO_TELEMETRY=1 expo export --platform android --output-dir dist/android && EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir dist/ios && pnpm run ios:bundle-check",
    "build:web": "EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist/web --source-maps --clear",
    "check:web-native-leaks": "node scripts/check-web-native-leaks.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/build-e2e-web.mjs && playwright test",
    "test:ios:release-smoke": "EXPO_NO_TELEMETRY=1 node scripts/ios-release-smoke.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "deadcode": "knip --files --exports --dependencies --treat-config-hints-as-errors",
    "deadcode:fix": "knip --files --exports --dependencies --fix",
    "dup:check": "node ../../scripts/lint/run-jscpd.mjs src",
    "security:audit": "pnpm audit --prod --audit-level=moderate",
    "clean": "rm -rf dist coverage .vitest-reports .expo"
  },
  "dependencies": {
    "@ethersproject/shims": "^5.8.0",
    "@expo/metro-runtime": "~57.0.2",
    "@privy-io/expo": "^0.69.4",
    "@privy-io/expo-native-extensions": "^0.0.11",
    "@privy-io/react-auth": "^3.29.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@sentry/electron": "^7.17.0",
    "@sentry/react-native": "^8.23.0",
    "@tanstack/react-query": "^5.85.3",
    "@zapengine/app-core": "workspace:*",
    "@zapengine/brand-assets": "workspace:*",
    "@zapengine/design-tokens": "workspace:*",
    "@zapengine/types": "workspace:*",
    "expo": "~57.0.1",
    "expo-application": "~57.0.0",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.2",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-video": "~57.0.1",
    "expo-web-browser": "~57.0.0",
    "fast-text-encoding": "^1.0.6",
    "hls.js": "^1.6.5",
    "lucide-react-native": "^0.523.0",
    "nativewind": "^4.2.6",
    "posthog-js": "^1.418.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-get-random-values": "^2.0.0",
    "react-native-passkeys": "^0.4.1",
    "react-native-qrcode-styled": "0.3.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.10.0",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "devDependencies": {
    "@expo/metro-config": "~57.0.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "catalog:",
    "@types/react": "~19.2.2",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zapengine/knip-config": "workspace:*",
    "babel-preset-expo": "~57.0.1",
    "eslint": "catalog:",
    "eslint-config-expo": "~57.0.0",
    "expo-dev-client": "57.0.3",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
