{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm turbo run build:web --filter=@zapengine/app",
  "framework": null,
  "outputDirectory": "dist/web",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/podcast",
      "permanent": false,
      "missing": [
        {
          "type": "query",
          "key": "userId"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
