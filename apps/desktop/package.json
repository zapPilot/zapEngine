{
  "name": "@zapengine/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/build.mjs && electron-builder --config electron-builder.unsigned.yml --mac --publish never",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "deadcode": "knip --treat-config-hints-as-errors",
    "deadcode:fix": "knip --fix",
    "dup:check": "node ../../scripts/lint/run-jscpd.mjs src",
    "security:audit": "pnpm audit --prod --audit-level=moderate",
    "clean": "rm -rf dist coverage release",
    "package:bundle": "node scripts/build.mjs"
  },
  "dependencies": {
    "@sentry/electron": "^7.17.0",
    "@zapengine/app-core": "workspace:*",
    "@zapengine/design-tokens": "workspace:*",
    "@zapengine/types": "workspace:*",
    "electron-updater": "6.8.10",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zapengine/eslint-config": "workspace:*",
    "@zapengine/knip-config": "workspace:*",
    "@zapengine/tsconfig": "workspace:*",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
