{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@zapengine/landing-page",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": "out",
  "framework": null,
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]; then exit 0; fi; exit 1"
}
