{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@zapengine/landing-page",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": "out",
  "framework": null,
  "rewrites": [
    {
      "source": "/ipfs/:cid",
      "destination": "https://dweb.link/ipfs/:cid"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
