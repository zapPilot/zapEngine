# `format`/`format:check` run `prettier .` from this directory, and prettier
# resolves .gitignore relative to its CWD — the repo-root .gitignore is never
# consulted. Without this file a local bundle or render makes format:check
# fail on generated output.
build
out
coverage
.turbo
.jscpd

# Written by scripts (voiceover/capture) through JSON.stringify; reformatting
# them by hand would make the next regeneration look like a content change.
public/captures
src/videos/*/vo.manifest.json

public/music/*.json
public/music/README.md
