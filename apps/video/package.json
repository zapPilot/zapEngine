{
  "name": "@zapengine/video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/prepare-music.ts && remotion bundle src/index.ts",
    "capture": "tsx scripts/capture.ts",
    "check": "tsx scripts/check-narration.ts",
    "clean": "rm -rf build out coverage",
    "deadcode": "knip",
    "deadcode:fix": "knip --fix",
    "dev": "tsx scripts/studio.ts",
    "dup:check": "node ../../scripts/lint/run-jscpd.mjs src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ scripts/ *.ts --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ *.ts --fix",
    "music": "tsx scripts/music.ts",
    "render": "tsx scripts/render.ts",
    "stills": "tsx scripts/contact-sheet.ts",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "voiceover": "tsx scripts/voiceover.ts",
    "make": "tsx scripts/make.ts",
    "brand-audio": "tsx scripts/brand-audio.ts",
    "loop": "tsx scripts/loop.ts"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "@zapengine/design-tokens": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "4.0.532",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zapengine/eslint-config": "workspace:*",
    "@zapengine/knip-config": "workspace:*",
    "@zapengine/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "knip": "catalog:",
    "mediabunny": "1.56.1",
    "playwright-core": "^1.60.0",
    "prettier": "catalog:",
    "sharp": "^0.35.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:",
    "@zapengine/media-release": "workspace:*"
  },
  "engines": {
    "node": "24.x"
  }
}
