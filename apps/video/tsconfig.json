{
  "extends": "@zapengine/tsconfig/react.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "*.ts",
    "../kokode-ai/src/story/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "out",
    "coverage",
    "../kokode-ai/src/story/**/*.test.ts"
  ]
}
