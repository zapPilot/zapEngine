{
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    ".jscpd/**"
  ],
  "ignorePattern": [
    "import\\s.*from\\s.*",
    "import\\s*\\{[\\s\\S]*?\\}\\s*from\\s*'[^']*'",
    "import\\s+type\\s*\\{[\\s\\S]*?\\}\\s*from\\s*['\"][^'\"]+['\"]"
  ],
  "format": ["typescript"]
}
