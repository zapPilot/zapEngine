{
  "name": "@zapengine/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/generated/tokens.d.ts",
      "import": "./dist/generated/tokens.js"
    },
    "./css/variables.css": "./dist/css/variables.css",
    "./tokens.json": "./tokens.json",
    "./css/status.css": "./dist/css/status.css",
    "./fonts/static/*": "./fonts/static/*",
    "./brand/*": "./brand/*"
  },
  "files": [
    "dist",
    "tokens.json",
    "fonts/static",
    "brand"
  ],
  "scripts": {
    "build": "pnpm codegen && tsc && prettier --write dist/",
    "codegen": "pnpm codegen:css && pnpm codegen:ts",
    "codegen:css": "tsx src/css-variables.ts && tsx src/status-css.ts",
    "codegen:ts": "tsx src/ts-codegen.ts",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "deadcode": "knip",
    "deadcode:fix": "knip --fix",
    "dup:check": "node ../../scripts/lint/run-jscpd.mjs src",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fonts": "uv run --with fonttools --with brotli --with uharfbuzz scripts/fonts.py",
    "brand": "node scripts/brand.mjs"
  },
  "devDependencies": {
    "@zapengine/eslint-config": "workspace:*",
    "@zapengine/knip-config": "workspace:*",
    "@zapengine/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@resvg/resvg-js": "2.6.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": "24.x"
  }
}
