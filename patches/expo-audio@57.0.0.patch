+internal const val NEXT_TRACK_COMMAND = "nextTrack"
+internal const val PREVIOUS_TRACK_COMMAND = "previousTrack"
+
 // MediaSession reads artwork from Player.mediaMetadata, but expo-audio lock-screen metadata can
 // change independently of the underlying MediaItem. This wrapper lets the session observe those
 // metadata updates without replacing the active media item on the real ExoPlayer instance.
+//
+// It also owns track navigation. A standalone AudioPlayer has a single-item timeline, so ExoPlayer
+// never advertises the seek-to-next/previous commands and media3 drops the headset's
+// KEYCODE_MEDIA_NEXT/PREVIOUS. Advertising them here and forwarding them to JS — which owns the
+// queue — is what makes those buttons reach the app at all.
 @UnstableApi
 internal class MetadataInjectingPlayer(
-  player: Player
+  player: Player,
+  private val showNextTrack: Boolean = false,
+  private val showPreviousTrack: Boolean = false,
+  private val onTrackNavigation: (String) -> Unit = {}
 ) : ForwardingPlayer(player) {
   private val handler = Handler(applicationLooper)
   private val listeners = IdentityHashMap<Player.Listener, Player.Listener>()
   private var injectedMetadata: Metadata? = null
 
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands().buildUpon()
+    if (showNextTrack) {
+      commands.add(Player.COMMAND_SEEK_TO_NEXT)
+      commands.add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    }
+    if (showPreviousTrack) {
+      commands.add(Player.COMMAND_SEEK_TO_PREVIOUS)
+      commands.add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+    }
+    return commands.build()
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean = availableCommands.contains(command)
+
+  override fun seekToNext() {
+    if (showNextTrack) {
+      onTrackNavigation(NEXT_TRACK_COMMAND)
+      return
+    }
+    super.seekToNext()
+  }
+
+  override fun seekToNextMediaItem() {
+    if (showNextTrack) {
+      onTrackNavigation(NEXT_TRACK_COMMAND)
+      return
+    }
+    super.seekToNextMediaItem()
+  }
+
+  override fun seekToPrevious() {
+    if (showPreviousTrack) {
+      onTrackNavigation(PREVIOUS_TRACK_COMMAND)
+      return
+    }
+    super.seekToPrevious()
+  }
+
+  override fun seekToPreviousMediaItem() {
+    if (showPreviousTrack) {
+      onTrackNavigation(PREVIOUS_TRACK_COMMAND)
+      return
+    }
+    super.seekToPreviousMediaItem()
+  }
+
   override fun addListener(listener: Player.Listener) {
