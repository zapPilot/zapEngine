{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".env*",
    "config/env*.mjs",
    "config/env/*.env",
    ".jscpd.json",
    "pnpm-lock.yaml",
    "package.json",
    "pnpm-workspace.yaml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "ACCOUNT_API_URL",
    "ANALYTICS_ENGINE_URL",
    "PODCAST_API_URL",
    "CACHE_MAX_AGE_SECONDS",
    "CACHE_STALE_WHILE_REVALIDATE_SECONDS",
    "PRIVY_WEB_APP_ID",
    "PRIVY_MOBILE_APP_ID",
    "PRIVY_MOBILE_CLIENT_ID",
    "MORALIS_API_KEY",
    "ALCHEMY_API_KEY",
    "ENABLE_DEBUG_LOGGING",
    "ENABLE_DEV_LOGGING",
    "IPFS_GATEWAY",
    "IPFS_GATEWAY_FALLBACK",
    "GA_ID",
    "TRACK_RECORD_MOCK"
  ],
  "futureFlags": {
    "longerSignatureKey": true
  },
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "out/**",
        "build/**",
        "src/generated/**"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md", "!src/generated/**"],
      "env": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*", "VITE_*"]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md"],
      "env": ["EXPO_PUBLIC_*", "VITE_*"]
    },
    "codegen": {
      "inputs": ["$TURBO_DEFAULT$", "tokens.json", "!src/generated/**"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "codegen:css": {
      "inputs": ["$TURBO_DEFAULT$", "tokens.json"],
      "outputs": ["dist/css/variables.css"]
    },
    "codegen:ts": {
      "inputs": ["$TURBO_DEFAULT$", "tokens.json", "!src/generated/**"],
      "outputs": ["src/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*", "VITE_*"]
    },
    "dev:web": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*", "VITE_*"]
    },
    "ops:sync": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["format"],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md"],
      "passThroughEnv": [
        "DATABASE_READ_ONLY",
        "DATABASE_READ_ONLY_URL",
        "TEST_DATABASE_URL",
        "DATABASE_INTEGRATION_URL"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md"],
      "passThroughEnv": [
        "DATABASE_READ_ONLY",
        "DATABASE_READ_ONLY_URL",
        "TEST_DATABASE_URL",
        "DATABASE_INTEGRATION_URL"
      ],
      "outputs": ["coverage/**", "coverage.xml", "htmlcov/**"]
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "deadcode": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "deadcode:fix": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "dup:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/scripts/lint/run-jscpd.mjs"
      ],
      "outputs": []
    },
    "security:audit": {
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test:e2e:safe": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test:ios:release-smoke": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md"],
      "outputs": ["test-results/ios-release-smoke/**"]
    },
    "clean": {
      "cache": false
    },
    "sql:audit": {
      "outputs": [],
      "cache": true
    },
    "service-reachability": {
      "outputs": [],
      "cache": true
    },
    "pylint:duplicate-check": {
      "outputs": [],
      "cache": true
    }
  }
}
